{
  "run_name": "mage-colab-01",
  "drive_project": "/content/drive/MyDrive/ai_detection",
  "data_folder": "data/processed/tokenized",
  "output_folder": "runs",
  "local_folder": "/content/ai_detection_work",
  "dataset": "MAGE",
  "models": [
    "google-bert/bert-base-uncased",
    "FacebookAI/roberta-base",
    "answerdotai/ModernBERT-base",
    "answerdotai/ModernBERT-large",
    "chandar-lab/NeoBERT",
    "google/bigbird-roberta-base",
    "microsoft/deberta-v3-base"
  ],
  "variants": [
    "text_only",
    "with_features"
  ],
  "features": [
    "mtld",
    "yule_k",
    "hapax_ratio",
    "flesch",
    "noun_ratio",
    "verb_ratio",
    "adjective_ratio",
    "adverb_ratio",
    "function_word_ratio",
    "sentence_length_mean",
    "sentence_length_std",
    "parse_tree_depth_mean",
    "dependency_distance",
    "dependent_clause_ratio",
    "coordination_index",
    "passive_voice_ratio",
    "gunning_fog",
    "clausal_density",
    "left_branching_ratio",
    "character_bigram_entropy"
  ],
  "max_token_length": 512,
  "batch_size": 32,
  "learning_rate": 1e-05,
  "weight_decay": 0.01,
  "seed": 42,
  "fp16": true,
  "epochs": 4,
  "min_epochs": 1,
  "patience_epochs": 0.75,
  "min_delta": 0.0075,
  "priority": "f1",
  "eval_step": 2000,
  "checkpoint_steps": 1000,
  "max_sessions": 7,
  "gpu": "A100",
  "max_total_gpu_hours": 40
}
